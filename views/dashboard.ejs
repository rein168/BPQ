<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BBQ - Badminton Batch Queueing</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1A8F55" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/logo.webp" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    .dashboard-hero {
      text-align: center;
      padding: 48px 20px 32px;
    }
    .dashboard-hero img {
      width: 72px;
      height: 72px;
      margin-bottom: 12px;
    }
    .dashboard-hero h1 {
      font-size: var(--text-3xl);
      color: var(--color-primary);
      margin-bottom: 4px;
    }
    .dashboard-hero p {
      color: var(--text-secondary);
      font-size: var(--text-md);
      margin: 0;
    }
    .session-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.15s;
      text-decoration: none;
      color: inherit;
    }
    .session-card:last-child { border-bottom: none; }
    .session-card:hover { background: var(--neutral-50); }
    .session-status {
      font-size: var(--text-xs);
      font-weight: 600;
      padding: 3px 10px;
      border-radius: var(--radius-pill);
    }
    .session-status-active { background: var(--green-100); color: var(--green-900); }
    .session-status-ended  { background: var(--neutral-200); color: var(--neutral-600); }
    .session-card__actions {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-shrink: 0;
    }
    /* QR Share Modal */
    .qr-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .qr-modal {
      max-width: 340px;
      width: 90%;
      margin: auto;
    }
    .qr-modal__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .qr-modal #qrcode-rsvp {
      background: #fff;
      padding: 12px;
      border-radius: var(--radius-md);
    }
    .qr-modal__url {
      font-size: var(--text-xs);
      color: var(--text-muted);
      word-break: break-all;
      text-align: center;
    }
    .form-row {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }
    .form-row > * { flex: 1; }
    .form-row .form-sm { flex: 0 0 auto; }
    .form-input {
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: var(--text-sm);
      background: var(--bg-page);
      color: var(--text-primary);
    }
  </style>
</head>
<body>
  <!-- Top Nav -->
  <nav class="bbq-topnav">
    <div class="bbq-topnav__logo">
      <img src="/icons/logo.webp" alt="BBQ" width="34" height="34" />
      <span>BBQ</span>
    </div>
    <div class="bbq-topnav__title"></div>
    <div class="bbq-topnav__actions"></div>
  </nav>

  <main style="max-width: 640px; margin: 0 auto; padding: 0 16px 40px;">
    <!-- Hero -->
    <div class="dashboard-hero">
      <img src="/icons/logo.webp" alt="BBQ" width="72" height="72" />
      <h1>BBQ</h1>
      <p>Badminton Batch Queueing</p>
    </div>

    <!-- Create Game -->
    <div class="bbq-card" style="margin-bottom: 24px;">
      <div class="bbq-card__header"><i class="bi bi-plus-circle"></i> New Game</div>
      <div class="bbq-card__body">
        <form id="createSessionForm">
          <input type="text" id="sessionNameInput"
            placeholder="Game name (e.g., Tuesday Night)"
            required class="form-input"
            style="width:100%; margin-bottom:8px; font-size:var(--text-md);" />
          <div class="form-row">
            <input type="date" id="gameDateInput" class="form-input" />
            <input type="text" id="sessionPinInput"
              placeholder="Host PIN (4-6 digits)"
              pattern="\d{4,6}" maxlength="6" inputmode="numeric"
              class="form-input" />
          </div>
          <div class="form-row" style="margin-bottom:8px;">
            <div style="display:flex; align-items:center; gap:8px;">
              <label for="courtCountInput" style="font-size:var(--text-sm); color:var(--text-secondary); font-weight:500; white-space:nowrap;">Courts</label>
              <input type="number" id="courtCountInput" value="4" min="1" max="20" inputmode="numeric"
                class="form-input" style="width:56px; text-align:center; padding:10px 6px;" />
            </div>
          </div>
          <button type="submit" class="btn-bbq btn-bbq-primary" style="width:100%;">
            <i class="bi bi-plus-lg"></i> Create Game
          </button>
          <p style="font-size:var(--text-xs); color:var(--text-muted); margin:8px 0 0;">
            PIN protects host actions. Leave blank for open games. Court count can be adjusted later.
          </p>
        </form>
      </div>
    </div>

    <!-- Games list -->
    <div class="bbq-card">
      <div class="bbq-card__header"><i class="bi bi-calendar-event"></i> Games</div>
      <div id="sessionsContainer">
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <p>No games yet. Create one to get started!</p>
        </div>
      </div>
    </div>
  </main>

  <!-- RSVP QR Modal -->
  <div id="qrOverlay" class="qr-overlay" onclick="if(event.target===this)hideQrModal()">
    <div class="bbq-card qr-modal">
      <div class="bbq-card__header">
        <i class="bi bi-qr-code"></i> RSVP Link
        <button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="hideQrModal()" style="margin-left:auto; color:#fff; padding:4px 8px;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="bbq-card__body qr-modal__body">
        <p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; text-align:center;">
          Share this QR code so players can register before game day.
        </p>
        <div id="qrcode-rsvp"></div>
        <div id="qrUrl" class="qr-modal__url"></div>
        <button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="copyQrLink()" style="width:100%;">
          <i class="bi bi-clipboard"></i> Copy Link
        </button>
      </div>
    </div>
  </div>

  <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
  <script>
    const socket = io();
    let activeQrSessionId = null;
    let qrInstance = null;

    // XSS-safe text helper
    function esc(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Set default date to today
    document.getElementById('gameDateInput').valueAsDate = new Date();

    // Create session
    document.getElementById('createSessionForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('sessionNameInput').value.trim();
      if (!name) return;
      const pin = document.getElementById('sessionPinInput').value.trim() || undefined;
      const courtCount = parseInt(document.getElementById('courtCountInput').value, 10) || 4;
      const gameDate = document.getElementById('gameDateInput').value || undefined;

      try {
        const response = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, pin, courtCount, gameDate })
        });
        const data = await response.json();
        if (data.success) {
          window.location.href = '/session/' + data.sessionId;
        }
      } catch (err) {
        alert('Error creating session: ' + err.message);
      }
    });

    // Load sessions
    async function loadSessions() {
      try {
        const response = await fetch('/api/sessions');
        const data = await response.json();
        displaySessions(data.sessions);
      } catch (err) {
        console.error('Error loading sessions:', err);
      }
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
      } catch { return dateStr; }
    }

    function displaySessions(sessions) {
      const container = document.getElementById('sessionsContainer');
      if (!sessions || sessions.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><p>No games yet. Create one to get started!</p></div>';
        return;
      }

      container.innerHTML = sessions.map(session => {
        const dateDisplay = session.game_date
          ? '<i class="bi bi-calendar-event"></i> ' + esc(formatDate(session.game_date))
          : '<i class="bi bi-calendar"></i> ' + new Date(session.created_at).toLocaleDateString();
        return '<div class="session-card">' +
          '<a href="/session/' + session.id + '" style="flex:1; text-decoration:none; color:inherit;">' +
            '<div style="font-weight:500;">' + esc(session.name) +
              (session.hasPin ? ' <i class="bi bi-lock-fill" style="color:var(--text-muted); font-size:0.8em;"></i>' : '') +
            '</div>' +
            '<div style="font-size:var(--text-xs); color:var(--text-muted);">' + dateDisplay + '</div>' +
          '</a>' +
          '<div class="session-card__actions">' +
            (session.status === 'active'
              ? '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="event.stopPropagation(); showQrModal(' + session.id + ')" title="RSVP QR"><i class="bi bi-qr-code"></i></button>'
              : '') +
            '<span class="session-status session-status-' + session.status + '">' +
              session.status.charAt(0).toUpperCase() + session.status.slice(1) +
            '</span>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    // QR Modal
    function showQrModal(sessionId) {
      activeQrSessionId = sessionId;
      const overlay = document.getElementById('qrOverlay');
      overlay.style.display = 'flex';
      const url = window.location.origin + '/join/' + sessionId;
      document.getElementById('qrUrl').textContent = url;

      const container = document.getElementById('qrcode-rsvp');
      container.innerHTML = '';
      try {
        qrInstance = new QRCode(container, {
          text: url,
          width: 220,
          height: 220,
          colorDark: '#1A2420',
          colorLight: '#ffffff',
          correctLevel: QRCode.CorrectLevel.M
        });
      } catch (err) {
        container.innerHTML = '<p style="color:var(--text-muted);">Could not generate QR code</p>';
        console.error('QR generation error:', err);
      }
    }

    function hideQrModal() {
      document.getElementById('qrOverlay').style.display = 'none';
      activeQrSessionId = null;
      qrInstance = null;
    }

    function copyQrLink() {
      if (!activeQrSessionId) return;
      const url = window.location.origin + '/join/' + activeQrSessionId;
      navigator.clipboard.writeText(url).then(() => {
        const btn = event.target.closest('button');
        const origHTML = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
        setTimeout(() => { btn.innerHTML = origHTML; }, 1500);
      }).catch(() => {});
    }

    loadSessions();
    setInterval(loadSessions, 5000);

    // Service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('SW registered:', reg.scope))
        .catch(err => console.warn('SW registration failed:', err));
    }
  </script>
</body>
</html>
