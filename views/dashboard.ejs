<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BPQ - Badminton Players Queueing</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#667eea" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .container-center {
      max-width: 900px;
      width: 100%;
    }
    .card-header-custom {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px 20px;
      text-align: center;
      border-radius: 15px 15px 0 0;
    }
    .card-header-custom h1 {
      margin: 0;
      font-weight: 700;
      font-size: 2.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }
    .card-header-custom .subtitle {
      font-size: 1rem;
      opacity: 0.95;
      margin-top: 5px;
    }
    .btn-action {
      border-radius: 12px;
      padding: 12px 24px;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    .btn-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }
    .session-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      margin-bottom: 15px;
      transition: all 0.3s ease;
    }
    .session-card:hover {
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      transform: translateY(-2px);
    }
    .session-badge {
      font-size: 0.85rem;
      padding: 5px 12px;
      border-radius: 20px;
    }
    .badge-active {
      background-color: #28a745;
      color: white;
    }
    .badge-ended {
      background-color: #6c757d;
      color: white;
    }
  </style>
</head>
<body>
  <div class="container container-center">
    <div class="card border-0 shadow-lg">
      <div class="card-header-custom">
        <h1>🏸 BPQ</h1>
        <div class="subtitle">Badminton Players Queueing System</div>
      </div>
      <div class="card-body p-5">
        <!-- Create New Session -->
        <div class="mb-5">
          <h4 class="mb-3">Start a New Session</h4>
          <form id="createSessionForm" class="d-flex gap-2 flex-wrap">
            <input
              type="text"
              id="sessionNameInput"
              class="form-control form-control-lg"
              placeholder="Session name (e.g., Tuesday Night)"
              required
            />
            <button type="submit" class="btn btn-primary btn-lg btn-action">
              <i class="bi bi-plus-lg"></i> Create Session
            </button>
          </form>
        </div>

        <hr />

        <!-- Active Sessions -->
        <div>
          <h4 class="mb-3">Active Sessions</h4>
          <div id="sessionsContainer">
            <div class="text-center text-muted py-4">
              <i class="bi bi-inbox" style="font-size: 2rem;"></i>
              <p class="mt-2">No active sessions. Create one to get started!</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
  <script>
    const socket = io();

    // Create new session
    document.getElementById('createSessionForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('sessionNameInput').value.trim();
      if (!name) return;

      try {
        const response = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name })
        });
        const data = await response.json();
        if (data.success) {
          window.location.href = `/session/${data.sessionId}`;
        }
      } catch (err) {
        alert('Error creating session: ' + err.message);
      }
    });

    // XSS-safe text helper
    function esc(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Load sessions on page load
    async function loadSessions() {
      try {
        const response = await fetch('/api/sessions');
        const data = await response.json();
        displaySessions(data.sessions);
      } catch (err) {
        console.error('Error loading sessions:', err);
      }
    }

    function displaySessions(sessions) {
      const container = document.getElementById('sessionsContainer');
      if (!sessions || sessions.length === 0) {
        container.innerHTML = `
          <div class="text-center text-muted py-4">
            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
            <p class="mt-2">No sessions yet. Create one to get started!</p>
          </div>
        `;
        return;
      }

      container.innerHTML = sessions
        .map(
          (session) => `
        <div class="session-card card">
          <div class="card-body d-flex justify-content-between align-items-center">
            <div>
              <h5 class="card-title mb-1">${esc(session.name)}</h5>
              <small class="text-muted">
                <i class="bi bi-calendar"></i>
                ${new Date(session.created_at).toLocaleString()}
              </small>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span class="session-badge ${session.status === 'active' ? 'badge-active' : 'badge-ended'}">
                ${session.status.charAt(0).toUpperCase() + session.status.slice(1)}
              </span>
              <a href="/session/${session.id}" class="btn btn-outline-primary btn-sm btn-action">
                <i class="bi bi-arrow-right"></i> Open
              </a>
            </div>
          </div>
        </div>
      `
        )
        .join('');
    }

    loadSessions();
    setInterval(loadSessions, 5000); // Refresh every 5 seconds

    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then((reg) => console.log('SW registered:', reg.scope))
        .catch((err) => console.warn('SW registration failed:', err));
    }
  </script>
</body>
</html>
