<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BBQ - Badminton Batch Queueing</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#018A60" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/logo.webp" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    .dashboard-hero {
      text-align: center;
      padding: 48px 20px 24px;
    }
    .dashboard-hero img {
      width: 110px;
      height: 110px;
      margin-bottom: 4px;
    }
    .dashboard-hero h1 {
      font-size: var(--text-3xl);
      color: var(--color-primary);
      margin-bottom: 2px;
    }
    .dashboard-hero p {
      color: var(--text-secondary);
      font-size: var(--text-md);
      margin: 0;
    }
    .session-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.15s;
      text-decoration: none;
      color: inherit;
    }
    .session-card:last-child { border-bottom: none; }
    .session-card:hover { background: var(--neutral-50); }
    .session-status {
      font-size: var(--text-xs);
      font-weight: 600;
      padding: 3px 10px;
      border-radius: var(--radius-pill);
    }
    .session-status-active { background: var(--green-100); color: var(--green-900); }
    .session-status-ended  { background: var(--neutral-200); color: var(--neutral-600); }
    .session-card__actions {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-shrink: 0;
    }
    /* QR Share Modal */
    .qr-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .qr-modal {
      max-width: 340px;
      width: 90%;
      margin: auto;
    }
    .qr-modal__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .qr-modal #qrcode-rsvp {
      background: #fff;
      padding: 12px;
      border-radius: var(--radius-md);
    }
    .qr-modal__url {
      font-size: var(--text-xs);
      color: var(--text-muted);
      word-break: break-all;
      text-align: center;
    }
    .form-row {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }
    .form-row > * { flex: 1; }
    .form-row .form-sm { flex: 0 0 auto; }
    .form-input {
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: var(--text-sm);
      background: var(--bg-page);
      color: var(--text-primary);
    }
  </style>
</head>
<body>
  <!-- Top Nav -->
  <nav class="bbq-topnav">
    <div class="bbq-topnav__logo">
      <img src="/icons/logo.webp" alt="BBQ" width="40" height="40" />
    </div>
    <div class="bbq-topnav__title" style="flex:1; text-align:center;"></div>
    <div class="bbq-topnav__actions"></div>
  </nav>

  <main style="max-width: 640px; margin: 0 auto; padding: 0 16px 40px;">
    <!-- Hero -->
    <div class="dashboard-hero">
      <img src="/icons/logo.webp" alt="BBQ" width="110" height="110" />
      <h1>BBQ</h1>
      <p>Badminton Batch Queueing</p>
    </div>

    <!-- Create Game -->
    <div class="bbq-card" style="margin-bottom: 24px;">
      <div class="bbq-card__header"><i class="bi bi-plus-circle"></i> New Game</div>
      <div class="bbq-card__body">
        <form id="createSessionForm">
          <div class="form-row">
            <input type="date" id="gameDateInput" class="form-input" />
            <div class="form-sm" style="position:relative; flex:0 0 72px;">
              <label for="courtCountInput" style="position:absolute; top:-8px; left:50%; transform:translateX(-50%); font-size:10px; color:var(--text-muted); background:var(--bg-card); padding:0 4px; white-space:nowrap;">Courts</label>
              <input type="number" id="courtCountInput" value="4" min="1" max="20" inputmode="numeric"
                class="form-input" style="width:100%; text-align:center;" />
            </div>
          </div>
          <div class="form-row">
            <input type="text" id="sessionNameInput"
              placeholder="Game name"
              class="form-input" />
            <input type="text" id="sessionPinInput"
              placeholder="PIN (4-6)"
              pattern="\d{4,6}" maxlength="6" inputmode="numeric"
              class="form-input" style="flex:0 0 88px;" />
          </div>
          <button type="submit" class="btn-bbq btn-bbq-primary" style="width:100%;">
            <i class="bi bi-plus-lg"></i> Create Game
          </button>
          <p style="font-size:var(--text-xs); color:var(--text-muted); margin:8px 0 0;">
            Each court allows up to 8 players (4 playing, 4 rotating). PIN protects host actions.
          </p>
        </form>
      </div>
    </div>

    <!-- Games list -->
    <div class="bbq-card">
      <div class="bbq-card__header"><i class="bi bi-calendar-event"></i> Games</div>
      <div id="sessionsContainer">
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <p>No games yet. Create one to get started!</p>
        </div>
      </div>
    </div>
  </main>

  <!-- RSVP QR Modal -->
  <div id="qrOverlay" class="qr-overlay" onclick="if(event.target===this)hideQrModal()">
    <div class="bbq-card qr-modal">
      <div class="bbq-card__header">
        <i class="bi bi-qr-code"></i> <span id="qrModalTitle">RSVP Link</span>
        <button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="hideQrModal()" style="margin-left:auto; color:#fff; padding:4px 8px;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="bbq-card__body qr-modal__body">
        <p id="qrModalDesc" style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; text-align:center;">
          Share this QR code so players can register before game day.
        </p>
        <div id="qrcode-rsvp"></div>
        <div id="qrUrl" class="qr-modal__url"></div>
        <button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="copyQrLink()" style="width:100%;">
          <i class="bi bi-clipboard"></i> Copy Link
        </button>
      </div>
    </div>
  </div>

  <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
  <script>
    const socket = io();
    let activeQrSessionId = null;
    let qrInstance = null;

    // XSS-safe text helper
    function esc(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Set default date to today
    document.getElementById('gameDateInput').valueAsDate = new Date();

    // Create session
    document.getElementById('createSessionForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const gameDate = document.getElementById('gameDateInput').value || undefined;
      let name = document.getElementById('sessionNameInput').value.trim();
      // Default name to formatted date if empty
      if (!name) {
        if (gameDate) {
          try {
            const d = new Date(gameDate + 'T00:00:00');
            name = d.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
          } catch { name = gameDate; }
        } else {
          name = new Date().toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
        }
      }
      const pin = document.getElementById('sessionPinInput').value.trim() || undefined;
      const courtCount = parseInt(document.getElementById('courtCountInput').value, 10) || 4;

      try {
        const response = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, pin, courtCount, gameDate })
        });
        const data = await response.json();
        if (data.success) {
          window.location.href = '/session/' + data.sessionId;
        }
      } catch (err) {
        alert('Error creating session: ' + err.message);
      }
    });

    // Load sessions
    async function loadSessions() {
      try {
        const response = await fetch('/api/sessions');
        const data = await response.json();
        displaySessions(data.sessions);
      } catch (err) {
        console.error('Error loading sessions:', err);
      }
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
      } catch { return dateStr; }
    }

    function displaySessions(sessions) {
      const container = document.getElementById('sessionsContainer');
      if (!sessions || sessions.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><p>No games yet. Create one to get started!</p></div>';
        return;
      }

      // Filter out ended sessions
      const activeSessions = sessions.filter(s => s.status !== 'ended');

      if (activeSessions.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><p>No active games. Create one to get started!</p></div>';
        return;
      }

      // Determine if a session is "coming soon" (future game_date) vs ongoing (today or no date)
      function isComingSoon(session) {
        if (!session.game_date) return false;
        const today = new Date().toISOString().slice(0, 10);
        return session.game_date > today;
      }

      container.innerHTML = activeSessions.map(session => {
        const dateDisplay = session.game_date
          ? '<i class="bi bi-calendar-event"></i> ' + esc(formatDate(session.game_date))
          : '<i class="bi bi-calendar"></i> ' + new Date(session.created_at).toLocaleDateString();
        const comingSoon = isComingSoon(session);

        // Actions: coming soon = Register pill (opens registration QR), ongoing = QR icon + Active pill
        let actionsHtml;
        if (comingSoon) {
          actionsHtml = '<button class="btn-bbq btn-bbq-sm" onclick="event.stopPropagation(); showQrModal(' + session.id + ',\'register\')" style="background:var(--color-primary); color:#fff; border:none; border-radius:var(--radius-pill); padding:4px 14px; font-size:var(--text-xs); font-weight:600; cursor:pointer;">' +
            '<i class="bi bi-qr-code"></i> Register</button>';
        } else {
          actionsHtml = '<button class="btn-bbq btn-bbq-ghost" onclick="event.stopPropagation(); showQrModal(' + session.id + ',\'arrive\')" title="Arrival QR" style="padding:4px 6px; font-size:20px; line-height:1;"><i class="bi bi-qr-code"></i></button>' +
            '<span class="session-status session-status-active">Active</span>';
        }

        return '<div class="session-card">' +
          '<a href="/session/' + session.id + '" style="flex:1; text-decoration:none; color:inherit;">' +
            '<div style="font-weight:500;">' + esc(session.name) +
              (session.hasPin ? ' <i class="bi bi-lock-fill" style="color:var(--text-muted); font-size:0.8em;"></i>' : '') +
            '</div>' +
            '<div style="font-size:var(--text-xs); color:var(--text-muted); display:flex; gap:10px; align-items:center;">' +
              '<span>' + dateDisplay + '</span>' +
              '<span><i class="bi bi-people-fill"></i> ' + (session.playerCount || 0) + '/' + (session.maxPlayers || 0) + '</span>' +
            '</div>' +
          '</a>' +
          '<div class="session-card__actions">' + actionsHtml + '</div>' +
        '</div>';
      }).join('');
    }

    // QR Modal
    let activeQrType = 'register';
    function showQrModal(sessionId, type) {
      activeQrSessionId = sessionId;
      activeQrType = type || 'register';
      const overlay = document.getElementById('qrOverlay');
      overlay.style.display = 'flex';

      const path = activeQrType === 'arrive' ? '/arrive/' : '/join/';
      const url = window.location.origin + path + sessionId;
      document.getElementById('qrUrl').textContent = url;

      // Update modal title and description
      if (activeQrType === 'arrive') {
        document.getElementById('qrModalTitle').textContent = 'Arrival Check-In';
        document.getElementById('qrModalDesc').textContent = 'Display this QR at the venue. Players scan to confirm they\'re here.';
      } else {
        document.getElementById('qrModalTitle').textContent = 'Registration Link';
        document.getElementById('qrModalDesc').textContent = 'Share this QR code so players can register before game day.';
      }

      const container = document.getElementById('qrcode-rsvp');
      container.innerHTML = '';
      try {
        qrInstance = new QRCode(container, {
          text: url,
          width: 220,
          height: 220,
          colorDark: '#1A2420',
          colorLight: '#ffffff',
          correctLevel: QRCode.CorrectLevel.M
        });
      } catch (err) {
        container.innerHTML = '<p style="color:var(--text-muted);">Could not generate QR code</p>';
        console.error('QR generation error:', err);
      }
    }

    function hideQrModal() {
      document.getElementById('qrOverlay').style.display = 'none';
      activeQrSessionId = null;
      qrInstance = null;
    }

    function copyQrLink() {
      if (!activeQrSessionId) return;
      const path = activeQrType === 'arrive' ? '/arrive/' : '/join/';
      const url = window.location.origin + path + activeQrSessionId;
      navigator.clipboard.writeText(url).then(() => {
        const btn = event.target.closest('button');
        const origHTML = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
        setTimeout(() => { btn.innerHTML = origHTML; }, 1500);
      }).catch(() => {});
    }

    loadSessions();
    setInterval(loadSessions, 5000);

    // Service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('SW registered:', reg.scope))
        .catch(err => console.warn('SW registration failed:', err));
    }
  </script>
</body>
</html>
