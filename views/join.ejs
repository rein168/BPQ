<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BBQ - Register</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#018A60" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/logo.webp" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .join-page {
      max-width: 420px;
      margin: 0 auto;
      padding: 24px 16px;
      min-height: calc(100vh - var(--nav-height));
      display: flex;
      flex-direction: column;
    }
    .join-hero {
      text-align: center;
      padding: 32px 0 24px;
    }
    .join-hero svg {
      width: 64px;
      height: 64px;
      margin-bottom: 12px;
    }
    .join-hero h1 {
      font-size: var(--text-2xl);
      color: var(--color-primary);
      margin-bottom: 4px;
    }
    .join-hero .session-name {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      font-weight: 500;
    }
    .join-form-group {
      margin-bottom: 16px;
    }
    .join-form-group label {
      display: block;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .join-input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: var(--text-md);
      background: var(--bg-card);
      color: var(--text-primary);
      transition: border-color 0.15s;
    }
    .join-input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(43,196,122,0.15);
    }
    .join-select {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: var(--text-md);
      background: var(--bg-card);
      color: var(--text-primary);
      appearance: auto;
    }
    .join-btn {
      width: 100%;
      padding: 14px;
      font-size: var(--text-lg);
      margin-top: 8px;
    }
    .join-success {
      text-align: center;
      padding: 40px 20px;
    }
    .join-success .checkmark {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--green-100);
      color: var(--green-700);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      margin: 0 auto 16px;
    }
    .join-success h2 {
      color: var(--color-primary);
      margin-bottom: 8px;
    }
    .join-success p {
      color: var(--text-secondary);
      font-size: var(--text-md);
    }
    .join-error {
      background: var(--coral-100);
      color: var(--coral-600);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      margin-bottom: 12px;
      display: none;
    }
    .join-info {
      background: var(--green-50);
      color: var(--green-900);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body>
  <!-- Top Nav -->
  <nav class="bbq-topnav">
    <a href="/" class="bbq-topnav__logo">
      <img src="/icons/logo.webp" alt="BBQ" width="34" height="34" style="border-radius:7px;" />
      <span>BBQ</span>
    </a>
    <div class="bbq-topnav__title">Register</div>
    <div class="bbq-topnav__actions"></div>
  </nav>

  <main class="join-page">
    <!-- Loading state -->
    <div id="loadingState">
      <div class="empty-state">
        <i class="bi bi-hourglass-split"></i>
        <p>Loading session...</p>
      </div>
    </div>

    <!-- Session not found -->
    <div id="notFoundState" style="display:none;">
      <div class="empty-state">
        <i class="bi bi-exclamation-triangle"></i>
        <p>Game not found or has ended.</p>
        <a href="/" class="btn-bbq btn-bbq-primary" style="margin-top:12px;">Back to Home</a>
      </div>
    </div>

    <!-- Registration form -->
    <div id="registerState" style="display:none;">
      <div class="join-hero">
        <img src="/icons/logo.webp" alt="BBQ" width="64" height="64" style="border-radius:14px;" />
        <h1>Register</h1>
        <div class="session-name" id="sessionNameDisplay"></div>
      </div>

      <div id="joinError" class="join-error"></div>

      <form id="joinForm">
        <div class="join-form-group">
          <label for="playerName">Your Name</label>
          <input type="text" id="playerName" class="join-input" placeholder="Enter your name" required maxlength="100" autocomplete="name" />
        </div>
        <div class="join-form-group">
          <label for="skillLevel">Skill Level</label>
          <select id="skillLevel" class="join-select" required>
            <option value="">Select your level</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
          </select>
        </div>
        <!-- +1 Guests -->
        <div id="guestsContainer"></div>
        <button type="button" class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="addGuest()" style="margin-bottom:12px; width:100%;">
          <i class="bi bi-person-plus"></i> +1 Guest
        </button>
        <button type="submit" class="btn-bbq btn-bbq-primary join-btn" id="joinBtn">
          <i class="bi bi-person-plus-fill"></i> Register
        </button>
      </form>

      <div class="join-info" style="margin-top:16px;">
        <i class="bi bi-info-circle"></i>
        You'll be added to the queue and allocated to a court when it's your turn.
      </div>
    </div>

    <!-- Success state -->
    <div id="successState" style="display:none;">
      <div class="join-success">
        <div class="checkmark"><i class="bi bi-check-lg"></i></div>
        <h2>You're In!</h2>
        <p id="successMessage">You've been added to the queue.</p>
        <p style="font-size:var(--text-sm); color:var(--text-muted); margin-top:16px;">
          Watch the courts screen for your turn, or check the live queue:
        </p>
        <a id="sessionLink" href="#" class="btn-bbq btn-bbq-outline" style="margin-top:12px;">
          <i class="bi bi-eye"></i> View Game
        </a>
      </div>
    </div>

    <!-- Already registered -->
    <div id="alreadyRegisteredState" style="display:none;">
      <div class="join-success">
        <div class="checkmark" style="background:var(--green-100);"><i class="bi bi-person-check"></i></div>
        <h2 id="welcomeBackName">Welcome Back!</h2>
        <p id="alreadyMessage">You're already registered for this game.</p>
        <a id="sessionLinkExisting" href="#" class="btn-bbq btn-bbq-primary" style="margin-top:16px;">
          <i class="bi bi-eye"></i> View Game
        </a>
      </div>
    </div>
  </main>

  <script>
    const sessionId = window.location.pathname.split('/')[2]; // /join/:sessionId

    // XSS-safe text helper
    function esc(str) {
      if (str == null) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function showState(stateId) {
      ['loadingState', 'notFoundState', 'registerState', 'successState', 'alreadyRegisteredState']
        .forEach(id => document.getElementById(id).style.display = 'none');
      document.getElementById(stateId).style.display = '';
    }

    // Check if player already registered (via localStorage)
    function getRegisteredPlayer() {
      try {
        const data = localStorage.getItem('bbq_player_' + sessionId);
        return data ? JSON.parse(data) : null;
      } catch { return null; }
    }

    function saveRegisteredPlayer(playerId, name) {
      try {
        localStorage.setItem('bbq_player_' + sessionId, JSON.stringify({ playerId, name }));
      } catch { /* ignore */ }
    }

    // Load session info
    async function init() {
      try {
        const response = await fetch('/api/sessions/' + sessionId);
        if (!response.ok) { showState('notFoundState'); return; }
        const data = await response.json();
        const session = data.session;

        if (session.status === 'ended') { showState('notFoundState'); return; }

        document.getElementById('sessionNameDisplay').textContent = session.name;
        document.getElementById('sessionLink').href = '/session/' + sessionId;
        document.getElementById('sessionLinkExisting').href = '/session/' + sessionId;

        // Set button text with game date
        if (session.game_date) {
          try {
            const d = new Date(session.game_date + 'T00:00:00');
            const dateStr = d.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
            document.getElementById('joinBtn').innerHTML = '<i class="bi bi-person-plus-fill"></i> Will Join ' + esc(dateStr) + ' Game';
          } catch { /* keep default */ }
        }

        // Check if already registered
        const existing = getRegisteredPlayer();
        if (existing) {
          document.getElementById('welcomeBackName').textContent = 'Welcome back, ' + esc(existing.name) + '!';
          document.getElementById('alreadyMessage').textContent = "You're already registered for this game.";
          showState('alreadyRegisteredState');
          // Also ping the check-in endpoint to update arrived_at
          try {
            await fetch('/api/players/checkin', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sessionId: parseInt(sessionId), playerId: existing.playerId })
            });
          } catch { /* best effort */ }
          return;
        }

        showState('registerState');
      } catch {
        showState('notFoundState');
      }
    }

    // +1 Guest management
    let guestCount = 0;
    function addGuest() {
      guestCount++;
      const container = document.getElementById('guestsContainer');
      const guestId = 'guest-' + guestCount;
      const div = document.createElement('div');
      div.id = guestId;
      div.style.cssText = 'margin-bottom:12px; padding:12px; border:1px dashed var(--border); border-radius:var(--radius-md); background:var(--bg-page);';
      div.innerHTML =
        '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">' +
          '<span style="font-family:var(--font-heading); font-weight:600; font-size:var(--text-sm); color:var(--text-secondary);"><i class="bi bi-person-plus"></i> +1 GUEST</span>' +
          '<button type="button" class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="removeGuest(\'' + guestId + '\')" style="padding:2px 6px; color:var(--color-danger);"><i class="bi bi-x-lg"></i></button>' +
        '</div>' +
        '<div class="join-form-group" style="margin-bottom:8px;">' +
          '<input type="text" class="join-input guest-name" placeholder="Guest name" maxlength="100" />' +
        '</div>' +
        '<div class="join-form-group" style="margin-bottom:0;">' +
          '<select class="join-select guest-skill">' +
            '<option value="Beginner">Beginner</option>' +
            '<option value="Intermediate">Intermediate</option>' +
          '</select>' +
        '</div>';
      container.appendChild(div);
    }

    function removeGuest(guestId) {
      const el = document.getElementById(guestId);
      if (el) el.remove();
    }

    // Submit registration
    document.getElementById('joinForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('playerName').value.trim();
      const skillLevel = document.getElementById('skillLevel').value;
      const errorEl = document.getElementById('joinError');
      errorEl.style.display = 'none';

      if (!name || !skillLevel) {
        errorEl.textContent = 'Please fill in all fields.';
        errorEl.style.display = 'block';
        return;
      }

      // Collect guests
      const guests = [];
      document.querySelectorAll('#guestsContainer > div').forEach(div => {
        const gName = div.querySelector('.guest-name').value.trim();
        const gSkill = div.querySelector('.guest-skill').value;
        if (gName) guests.push({ name: gName, skillLevel: gSkill });
      });

      // Validate guest names
      const emptyGuest = document.querySelectorAll('#guestsContainer .guest-name');
      for (const input of emptyGuest) {
        if (!input.value.trim()) {
          errorEl.textContent = 'Please enter a name for each guest, or remove empty guests.';
          errorEl.style.display = 'block';
          return;
        }
      }

      try {
        // Register primary player
        const response = await fetch('/api/players/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), name, skillLevel })
        });
        const data = await response.json();

        if (!response.ok) {
          errorEl.textContent = data.error || 'Registration failed.';
          errorEl.style.display = 'block';
          return;
        }

        // Save to localStorage for re-visit detection
        saveRegisteredPlayer(data.playerId, name);

        // Register guests
        const guestResults = [];
        for (const guest of guests) {
          try {
            const gRes = await fetch('/api/players/register', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sessionId: parseInt(sessionId), name: guest.name, skillLevel: guest.skillLevel })
            });
            const gData = await gRes.json();
            guestResults.push({ name: guest.name, ok: gRes.ok, error: gData.error });
          } catch {
            guestResults.push({ name: guest.name, ok: false, error: 'Network error' });
          }
        }

        let msg = name + ', you\'ve been registered!';
        const okGuests = guestResults.filter(g => g.ok);
        const failGuests = guestResults.filter(g => !g.ok);
        if (okGuests.length > 0) msg += ' ' + okGuests.map(g => g.name).join(', ') + ' also added.';
        if (failGuests.length > 0) msg += ' Could not add: ' + failGuests.map(g => g.name + ' (' + g.error + ')').join(', ') + '.';

        document.getElementById('successMessage').textContent = msg;
        showState('successState');
      } catch {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.style.display = 'block';
      }
    });

    init();
  </script>
</body>
</html>
