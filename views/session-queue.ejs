<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BBQ - Game</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1A8F55" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/logo.webp" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    /* Page-specific overrides */
    .team-divider {
      text-align: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-sm);
      color: var(--text-muted);
      padding: 4px 0;
    }

    /* QR Modal */
    .qr-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .qr-modal {
      max-width: 340px;
      width: 90%;
      margin: auto;
    }
    .qr-modal__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .qr-modal #qrcode {
      background: #fff;
      padding: 12px;
      border-radius: var(--radius-md);
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 auto;
    }
    .qr-modal__url {
      font-size: var(--text-xs);
      color: var(--text-muted);
      word-break: break-all;
      text-align: center;
    }

    /* Player card grid for Players tab */
    .player-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 12px 0;
    }
    .player-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      background: var(--bg-card);
      transition: background 0.15s;
    }
    .player-card__info {
      flex: 1;
      min-width: 0;
    }
    .player-card__name {
      font-weight: 600;
      font-size: var(--text-md);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .player-card__meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
      font-size: var(--text-xs);
      color: var(--text-muted);
    }
    .player-card__stats {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      flex-shrink: 0;
      min-width: 0;
    }
    /* Compact player card on small screens */
    .player-card {
      flex-wrap: wrap;
    }
    @media (max-width: 400px) {
      .player-card__actions {
        width: 100%;
        justify-content: flex-end;
        padding-top: 4px;
        border-top: 1px solid var(--border-subtle);
        margin-top: 4px;
      }
    }
    .player-card__wl {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-md);
      font-variant-numeric: tabular-nums;
    }
    .player-card__games {
      font-size: var(--text-xs);
      color: var(--text-muted);
    }
    .player-card__actions {
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }
    .players-summary {
      display: flex;
      gap: 12px;
      padding: 12px 0;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      flex-wrap: wrap;
    }
    .players-summary__stat {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .players-summary__stat strong {
      font-variant-numeric: tabular-nums;
    }

    /* Arrival dot */
    .arrival-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      display: inline-block;
    }
    .arrival-dot--arrived {
      background: var(--green-500);
      box-shadow: 0 0 4px rgba(43,196,122,0.4);
    }
    .arrival-dot--pending {
      background: var(--neutral-400);
    }

    /* Hold-to-confirm button */
    .hold-btn {
      position: relative;
      overflow: hidden;
      width: 100%;
      margin-top: 16px;
      padding: 16px;
      font-size: var(--text-lg);
      font-family: var(--font-heading);
      font-weight: 700;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      transition: opacity 0.15s;
    }
    .hold-btn--end {
      background: var(--coral-500);
      color: #fff;
    }
    .hold-btn--start {
      background: var(--color-primary);
      color: #fff;
    }
    .hold-btn__fill {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 0%;
      background: rgba(0,0,0,0.25);
      transition: none;
      pointer-events: none;
    }
    .hold-btn.holding .hold-btn__fill {
      width: 100%;
      transition: width 2s linear;
    }
    .hold-btn__label {
      position: relative;
      z-index: 1;
    }

    /* Queue batch card */
    .batch-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--bg-card);
      margin-bottom: 12px;
      overflow: hidden;
    }
    .batch-card__header {
      background: var(--color-primary);
      color: #fff;
      padding: 8px 14px;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: var(--text-sm);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .batch-card__body {
      padding: 12px 14px;
      display: flex;
      gap: 8px;
    }
    .batch-card__team {
      flex: 1;
    }
    .batch-card__team-label {
      text-align: center;
      font-size: var(--text-xs);
      font-weight: 700;
      margin-bottom: 4px;
    }

    /* Stats table */
    .stats-table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-sm);
    }
    .stats-table th {
      text-align: left;
      padding: 8px 10px;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: var(--text-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid var(--border);
    }
    .stats-table td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border-subtle);
      font-variant-numeric: tabular-nums;
    }
    .stats-table tr:last-child td { border-bottom: none; }
    .stats-table .col-name { font-weight: 500; }
    .stats-table .col-num { text-align: center; width: 50px; }
    .stats-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .stats-summary__tile {
      text-align: center;
      padding: 16px 8px;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--bg-card);
    }
    .stats-summary__value {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: var(--text-2xl);
      font-variant-numeric: tabular-nums;
      color: var(--color-primary);
    }
    .stats-summary__label {
      font-size: var(--text-xs);
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Court count bar */
    .court-count-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <!-- Top Nav -->
  <nav class="bbq-topnav">
    <a href="/" class="bbq-topnav__logo">
      <img src="/icons/logo.webp" alt="BBQ" width="34" height="34" />
      <span>BBQ</span>
    </a>
    <div class="bbq-topnav__title" id="sessionName">Loading...</div>
    <div class="bbq-topnav__actions">
      <button class="btn-bbq btn-bbq-ghost" onclick="showQrModal()" title="Arrival QR Code" style="padding:4px 6px; font-size:28px; line-height:1;">
        <i class="bi bi-qr-code"></i>
      </button>
      <button class="btn-bbq btn-bbq-outline btn-bbq-sm viewer-only" onclick="showPinModal()" id="unlockBtn" style="display:none;">
        <i class="bi bi-unlock"></i>
      </button>
    </div>
  </nav>

  <!-- PIN Auth Modal -->
  <div id="pinOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:300; display:none; align-items:center; justify-content:center;">
    <div class="bbq-card" style="max-width:320px; width:90%; margin:auto;">
      <div class="bbq-card__header"><i class="bi bi-lock-fill"></i> Host PIN Required</div>
      <div class="bbq-card__body">
        <p style="font-size:var(--text-sm); color:var(--text-secondary); margin-bottom:12px;">Enter the host PIN to manage this game, or view as a player.</p>
        <input type="text" id="pinInput" class="score-input" style="width:100%; font-size:var(--text-xl);"
          placeholder="Enter PIN" pattern="\d{4,6}" maxlength="6" inputmode="numeric" autocomplete="off" />
        <div id="pinError" style="display:none; color:var(--color-danger); font-size:var(--text-sm); margin-top:8px;"></div>
        <div style="display:flex; gap:8px; margin-top:16px;">
          <button class="btn-bbq btn-bbq-ghost" style="flex:1;" onclick="skipPin()">View as Player</button>
          <button class="btn-bbq btn-bbq-primary" style="flex:1;" onclick="submitPin()">Authenticate</button>
        </div>
      </div>
    </div>
  </div>

  <!-- QR Code Modal (Arrival) -->
  <div id="qrOverlay" class="qr-overlay" onclick="if(event.target===this)hideQrModal()">
    <div class="bbq-card qr-modal">
      <div class="bbq-card__header">
        <i class="bi bi-qr-code"></i> Arrival QR
        <button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="hideQrModal()" style="margin-left:auto; color:#fff; padding:4px 8px;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="bbq-card__body qr-modal__body">
        <p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; text-align:center;">
          Players scan this QR on arrival to check in. New players can also register here.
        </p>
        <div id="qrcode"></div>
        <div id="qrUrl" class="qr-modal__url"></div>
        <button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="copyQrLink()" style="width:100%;">
          <i class="bi bi-clipboard"></i> Copy Link
        </button>
      </div>
    </div>
  </div>

  <!-- Main content area — tab panes -->
  <main style="padding: 16px; max-width: 960px; margin: 0 auto;">

    <!-- COURTS TAB -->
    <div id="tab-courts" class="tab-pane active">
      <!-- Court count adjuster (host only) -->
      <div class="court-count-bar host-only" id="courtCountBar">
        <label for="courtCountInput" style="font-size:var(--text-sm); color:var(--text-secondary); font-weight:600; white-space:nowrap;">Courts</label>
        <input type="number" id="courtCountInput" value="0" min="1" max="20" inputmode="numeric"
          style="width:56px; padding:8px 4px; text-align:center; border:1.5px solid var(--border); border-radius:var(--radius-sm); font-family:var(--font-heading); font-weight:700; font-size:var(--text-lg); background:var(--bg-card); color:var(--text-primary); font-variant-numeric:tabular-nums;"
          onchange="setCourtCount(this.value)" />
        <button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="addCourt()" style="width:40px; height:36px; padding:0; font-size:18px; display:flex; align-items:center; justify-content:center;">
          <i class="bi bi-plus-lg"></i>
        </button>
        <button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="removeCourt()" style="width:40px; height:36px; padding:0; font-size:18px; display:flex; align-items:center; justify-content:center;">
          <i class="bi bi-dash-lg"></i>
        </button>
      </div>
      <div id="courtsContainer">
        <div class="empty-state">
          <i class="bi bi-grid-3x3-gap"></i>
          <p>No courts available</p>
        </div>
      </div>
    </div>

    <!-- PLAYERS TAB -->
    <div id="tab-players" class="tab-pane">
      <div class="players-summary" id="playersSummary"></div>
      <div id="playersContainer">
        <div class="empty-state">
          <i class="bi bi-people"></i>
          <p>No players yet. Share the QR code to let players join!</p>
        </div>
      </div>
    </div>

    <!-- QUEUE TAB -->
    <div id="tab-queue" class="tab-pane">
      <!-- Explainer -->
      <div style="display:flex; align-items:flex-start; gap:8px; padding:10px 14px; margin-bottom:12px; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-md); font-size:var(--text-xs); color:var(--text-muted);">
        <i class="bi bi-info-circle" style="flex-shrink:0; margin-top:1px;"></i>
        <span>Court assignments are tentative and will change based on which court becomes available first.</span>
      </div>

      <!-- Queue batches -->
      <div id="queueContainer">
        <div class="empty-state"><p>Queue is empty</p></div>
      </div>
    </div>

    <!-- STATS TAB -->
    <div id="tab-stats" class="tab-pane">
      <div id="statsContainer">
        <div class="empty-state"><i class="bi bi-bar-chart-line"></i><p>No stats yet</p></div>
      </div>
    </div>

  </main>

  <!-- Notification container -->
  <div id="notificationContainer"></div>

  <!-- Bottom Nav -->
  <nav class="bbq-bottomnav">
    <button class="bbq-bottomnav__tab active" onclick="switchTab('courts', this)">
      <i class="bi bi-grid-3x3-gap-fill"></i>
      Courts
    </button>
    <button class="bbq-bottomnav__tab" onclick="switchTab('queue', this)">
      <i class="bi bi-list-ol"></i>
      Queue
    </button>
    <button class="bbq-bottomnav__tab" onclick="switchTab('players', this)">
      <i class="bi bi-people-fill"></i>
      Players
    </button>
    <button class="bbq-bottomnav__tab" onclick="switchTab('stats', this)">
      <i class="bi bi-bar-chart-line-fill"></i>
      Stats
    </button>
  </nav>

  <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
  <script>
    const sessionId = window.location.pathname.split('/').pop();
    const socket = io();
    let sessionState = null;
    let userRole = 'viewer';
    let timerInterval = null;

    // XSS-safe text helper
    function esc(str) {
      if (str == null) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Format milliseconds as MM:SS
    function formatTimer(ms) {
      const totalSec = Math.floor(ms / 1000);
      const m = Math.floor(totalSec / 60);
      const s = totalSec % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    // Format arrival time
    function formatTime(ts) {
      if (!ts) return '—';
      return new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    }

    // Timer tick
    function startTimerTick() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        document.querySelectorAll('[data-match-started]').forEach(el => {
          const started = parseInt(el.getAttribute('data-match-started'), 10);
          if (started) el.textContent = formatTimer(Date.now() - started);
        });
      }, 1000);
    }
    startTimerTick();

    // ===== Tab switching =====
    function switchTab(tabName, btnEl) {
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.bbq-bottomnav__tab').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + tabName).classList.add('active');
      if (btnEl) btnEl.classList.add('active');
      if (tabName === 'stats') loadStats();
    }

    // ===== Role management =====
    async function checkRole() {
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/role');
        const data = await response.json();
        setRole(data.role);
        if (data.hasPin && data.role !== 'host') {
          document.getElementById('pinOverlay').style.display = 'flex';
        }
      } catch (err) {
        console.error('Error checking role:', err);
        setRole('viewer');
      }
    }

    function setRole(role) {
      userRole = role;
      document.body.classList.remove('role-host', 'role-viewer');
      document.body.classList.add('role-' + role);
    }

    function showPinModal() {
      document.getElementById('pinOverlay').style.display = 'flex';
    }

    async function submitPin() {
      const pin = document.getElementById('pinInput').value.trim();
      const errorEl = document.getElementById('pinError');
      errorEl.style.display = 'none';
      if (!pin) { errorEl.textContent = 'Please enter a PIN'; errorEl.style.display = 'block'; return; }
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin })
        });
        const data = await response.json();
        if (data.success) {
          setRole('host');
          document.getElementById('pinOverlay').style.display = 'none';
          document.getElementById('pinInput').value = '';
        } else {
          errorEl.textContent = data.error || 'Incorrect PIN';
          errorEl.style.display = 'block';
        }
      } catch {
        errorEl.textContent = 'Error authenticating';
        errorEl.style.display = 'block';
      }
    }

    function skipPin() {
      setRole('viewer');
      document.getElementById('pinOverlay').style.display = 'none';
    }

    document.getElementById('pinInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') submitPin();
    });

    checkRole();

    // ===== QR Code (Arrival) =====
    let qrInstance = null;
    function getJoinUrl() {
      return window.location.origin + '/join/' + sessionId;
    }

    function showQrModal() {
      const overlay = document.getElementById('qrOverlay');
      overlay.style.display = 'flex';
      const url = getJoinUrl();
      document.getElementById('qrUrl').textContent = url;

      if (!qrInstance) {
        const container = document.getElementById('qrcode');
        container.innerHTML = '';
        try {
          qrInstance = new QRCode(container, {
            text: url,
            width: 220,
            height: 220,
            colorDark: '#1A2420',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
          });
        } catch (err) {
          container.innerHTML = '<p style="color:var(--text-muted);">Could not generate QR code</p>';
          console.error('QR generation error:', err);
        }
      }
    }

    function hideQrModal() {
      document.getElementById('qrOverlay').style.display = 'none';
    }

    function copyQrLink() {
      navigator.clipboard.writeText(getJoinUrl()).then(() => {
        const btn = event.target.closest('button');
        const origHTML = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
        setTimeout(() => { btn.innerHTML = origHTML; }, 1500);
      }).catch(() => {});
    }

    // ===== Socket =====
    socket.emit('join-session', parseInt(sessionId));

    socket.on('session:' + sessionId, (data) => {
      sessionState = data;
      updateUI();
    });

    socket.on('session:' + sessionId + ':court-assigned', (data) => {
      showCourtNotification(data);
    });

    // ===== Actions =====

    // End match on a court
    async function finishMatch(courtId) {
      try {
        const response = await fetch('/api/queue/' + courtId + '/finish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
        const data = await response.json();
        if (data.success) {
          // Switch to stats tab if there's a new match to score
          socket.emit('get-session-state', parseInt(sessionId));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // Start the match timer on a court (players already assigned)
    async function startGame(courtId) {
      try {
        const response = await fetch('/api/queue/begin/' + courtId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
        const data = await response.json();
        if (!data.success) alert(data.error || 'Could not start game');
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ===== Hold-to-confirm button logic =====
    let holdTimer = null;
    let holdingBtn = null;

    function startHold(btn) {
      if (holdTimer) return;
      holdingBtn = btn;
      btn.classList.add('holding');
      holdTimer = setTimeout(() => {
        btn.classList.remove('holding');
        holdTimer = null;
        holdingBtn = null;
        const courtId = btn.getAttribute('data-court-id');
        const action = btn.getAttribute('data-action');
        if (action === 'end') finishMatch(parseInt(courtId));
        else if (action === 'start') startGame(parseInt(courtId));
      }, 2000);
    }

    function cancelHold() {
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = null;
      }
      if (holdingBtn) {
        holdingBtn.classList.remove('holding');
        holdingBtn = null;
      }
    }

    // Delegate hold events from the courts container
    document.addEventListener('mousedown', (e) => {
      const btn = e.target.closest('.hold-btn');
      if (btn) { e.preventDefault(); startHold(btn); }
    });
    document.addEventListener('mouseup', cancelHold);
    document.addEventListener('mouseleave', cancelHold);
    document.addEventListener('touchstart', (e) => {
      const btn = e.target.closest('.hold-btn');
      if (btn) { e.preventDefault(); startHold(btn); }
    }, { passive: false });
    document.addEventListener('touchend', cancelHold);
    document.addEventListener('touchcancel', cancelHold);

    // ===== Court count adjustment =====
    async function addCourt() {
      try {
        const response = await fetch('/api/courts/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
        const data = await response.json();
        if (!data.success) alert(data.error || 'Failed to add court');
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function removeCourt() {
      if (!sessionState || !sessionState.courts) return;
      // Remove the last unoccupied court
      const courts = sessionState.courts;
      const lastEmpty = [...courts].reverse().find(c => !c.match);
      if (!lastEmpty) { alert('All courts are in use'); return; }
      try {
        const response = await fetch('/api/courts/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), courtId: lastEmpty.court.id })
        });
        const data = await response.json();
        if (!data.success) alert(data.error || 'Failed to remove court');
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // Set court count via text input
    async function setCourtCount(value) {
      const target = Math.max(1, Math.min(parseInt(value, 10) || 1, 20));
      if (!sessionState || !sessionState.courts) return;
      const current = sessionState.courts.length;
      if (target === current) return;

      if (target > current) {
        for (let i = 0; i < target - current; i++) await addCourt();
      } else {
        for (let i = 0; i < current - target; i++) await removeCourt();
      }
    }

    async function setPlayerStatus(playerId, status) {
      try {
        await fetch('/api/players/' + playerId + '/status', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), status })
        });
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function removePlayer(playerId) {
      if (!confirm('Remove this player?')) return;
      try {
        await fetch('/api/players/' + playerId, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ===== Stats =====
    async function loadStats() {
      try {
        const [histRes, statsRes] = await Promise.all([
          fetch('/api/sessions/' + sessionId + '/history'),
          fetch('/api/sessions/' + sessionId + '/stats')
        ]);
        const histData = await histRes.json();
        const statsData = await statsRes.json();
        renderStatsTab(histData.history || [], statsData);
      } catch (err) {
        console.error('Error loading stats:', err);
      }
    }

    function renderStatsTab(history, stats) {
      const container = document.getElementById('statsContainer');
      const players = stats.playerStats || [];
      const summary = stats.summary || {};

      if (players.length === 0 && history.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-bar-chart-line"></i><p>No stats yet. Start a game to see stats here.</p></div>';
        return;
      }

      const avgMin = summary.totalMatches > 0 ? (summary.avgDurationMs / 60000).toFixed(1) : '0';

      let html = '';
      // Summary tiles
      html += '<div class="stats-summary">' +
        '<div class="stats-summary__tile"><div class="stats-summary__value">' + (summary.totalMatches || 0) + '</div><div class="stats-summary__label">Matches</div></div>' +
        '<div class="stats-summary__tile"><div class="stats-summary__value">' + players.length + '</div><div class="stats-summary__label">Players</div></div>' +
        '<div class="stats-summary__tile"><div class="stats-summary__value">' + avgMin + 'm</div><div class="stats-summary__label">Avg Duration</div></div>' +
      '</div>';

      // Player stats table
      if (players.length > 0) {
        // Sort: most games first, then by win rate
        const sorted = [...players].sort((a, b) => {
          const gA = a.games_played || 0, gB = b.games_played || 0;
          if (gB !== gA) return gB - gA;
          const wrA = gA > 0 ? (a.wins || 0) / gA : 0;
          const wrB = gB > 0 ? (b.wins || 0) / gB : 0;
          return wrB - wrA;
        });

        html += '<div class="bbq-card"><div class="bbq-card__header"><i class="bi bi-bar-chart-line"></i> Player Stats</div><div class="bbq-card__body" style="padding:0; overflow-x:auto;">';
        html += '<table class="stats-table">' +
          '<thead><tr>' +
            '<th>Player</th>' +
            '<th class="col-num">Games</th>' +
            '<th class="col-num">W</th>' +
            '<th class="col-num">L</th>' +
            '<th class="col-num">Win%</th>' +
          '</tr></thead><tbody>';
        for (const p of sorted) {
          const games = p.games_played || 0;
          const wins = p.wins || 0;
          const losses = p.losses || 0;
          const winPct = games > 0 ? Math.round((wins / games) * 100) : '—';
          html += '<tr>' +
            '<td class="col-name">' + esc(p.name) + '</td>' +
            '<td class="col-num">' + games + '</td>' +
            '<td class="col-num" style="color:var(--green-700);">' + wins + '</td>' +
            '<td class="col-num" style="color:var(--coral-500);">' + losses + '</td>' +
            '<td class="col-num">' + (winPct === '—' ? '—' : winPct + '%') + '</td>' +
          '</tr>';
        }
        html += '</tbody></table></div></div>';
      }

      // Recent match scores
      if (history.length > 0) {
        html += '<div class="bbq-card" style="margin-top:16px;"><div class="bbq-card__header"><i class="bi bi-clock-history"></i> Recent Matches</div><div class="bbq-card__body">';
        html += history.slice(0, 20).map(match => {
          const teamA = match.players.filter(p => p.team === 'A');
          const teamB = match.players.filter(p => p.team === 'B');
          const hasScore = match.score_a != null && match.score_b != null;
          const duration = (match.duration_ms / 60000).toFixed(1);

          if (hasScore) {
            const aWin = match.score_a > match.score_b;
            return '<div style="border:1px solid var(--border); border-radius:var(--radius-md); padding:12px; margin-bottom:8px;">' +
              '<div style="display:flex; justify-content:space-between; font-size:var(--text-xs); color:var(--text-muted); margin-bottom:6px;">' +
                '<span>' + duration + ' min</span>' +
                '<span>' + new Date(match.completed_at).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}) + '</span>' +
              '</div>' +
              '<div style="display:flex; align-items:center; gap:8px; padding:4px 0;">' +
                '<span style="font-weight:700; font-size:var(--text-xs); color:var(--green-700); width:20px;">A</span>' +
                '<span style="flex:1; font-size:var(--text-sm);">' + teamA.map(p => esc(p.name)).join(' & ') + '</span>' +
                '<span style="font-family:var(--font-heading); font-weight:800; font-size:var(--text-lg); color:' + (aWin ? 'var(--green-700)' : 'var(--coral-500)') + ';">' + match.score_a + '</span>' +
              '</div>' +
              '<div style="display:flex; align-items:center; gap:8px; padding:4px 0;">' +
                '<span style="font-weight:700; font-size:var(--text-xs); color:var(--coral-500); width:20px;">B</span>' +
                '<span style="flex:1; font-size:var(--text-sm);">' + teamB.map(p => esc(p.name)).join(' & ') + '</span>' +
                '<span style="font-family:var(--font-heading); font-weight:800; font-size:var(--text-lg); color:' + (!aWin ? 'var(--green-700)' : 'var(--coral-500)') + ';">' + match.score_b + '</span>' +
              '</div>' +
            '</div>';
          } else {
            // Needs score - host only
            return '<div style="border:1px solid var(--border); border-left:4px solid var(--color-accent); border-radius:var(--radius-md); padding:12px; margin-bottom:8px;">' +
              '<div style="display:flex; justify-content:space-between; font-size:var(--text-xs); margin-bottom:6px;">' +
                '<span style="color:var(--color-accent); font-weight:600;">Score needed</span>' +
                '<span style="color:var(--text-muted);">' + duration + ' min</span>' +
              '</div>' +
              '<div style="display:flex; align-items:center; gap:8px; padding:4px 0;">' +
                '<span style="font-weight:700; font-size:var(--text-xs); color:var(--green-700); width:20px;">A</span>' +
                '<span style="flex:1; font-size:var(--text-sm);">' + teamA.map(p => esc(p.name)).join(' & ') + '</span>' +
                '<input type="number" class="score-input" id="scoreA-' + match.id + '" min="0" max="99" placeholder="0" style="width:60px;" />' +
              '</div>' +
              '<div style="display:flex; align-items:center; gap:8px; padding:4px 0;">' +
                '<span style="font-weight:700; font-size:var(--text-xs); color:var(--coral-500); width:20px;">B</span>' +
                '<span style="flex:1; font-size:var(--text-sm);">' + teamB.map(p => esc(p.name)).join(' & ') + '</span>' +
                '<input type="number" class="score-input" id="scoreB-' + match.id + '" min="0" max="99" placeholder="0" style="width:60px;" />' +
              '</div>' +
              '<button class="btn-bbq btn-bbq-accent btn-bbq-sm" style="width:100%; margin-top:8px;" onclick="submitScore(' + match.id + ')">' +
                '<i class="bi bi-check-lg"></i> Save Score</button>' +
            '</div>';
          }
        }).join('');
        html += '</div></div>';
      }

      container.innerHTML = html;
    }

    async function submitScore(matchId) {
      const scoreAEl = document.getElementById('scoreA-' + matchId);
      const scoreBEl = document.getElementById('scoreB-' + matchId);
      if (!scoreAEl || !scoreBEl) return;
      const scoreA = parseInt(scoreAEl.value, 10);
      const scoreB = parseInt(scoreBEl.value, 10);
      if (isNaN(scoreA) || isNaN(scoreB)) { alert('Please enter both scores'); return; }
      try {
        const response = await fetch('/api/queue/score/' + matchId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), scoreA, scoreB })
        });
        const data = await response.json();
        if (data.success) {
          loadStats();
          socket.emit('get-session-state', parseInt(sessionId));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ===== Notification toast =====
    function showCourtNotification(data) {
      const container = document.getElementById('notificationContainer');
      const id = 'notif-' + Date.now();
      const names = data.playerNames.map(n => esc(n)).join(', ');
      container.insertAdjacentHTML('beforeend',
        '<div id="' + id + '" class="bbq-toast">' +
          '<button class="bbq-toast__close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>' +
          '<div class="bbq-toast__title"><i class="bi bi-arrow-right-circle-fill"></i> Next Up!</div>' +
          '<div class="bbq-toast__body"><strong>' + esc(data.courtName) + '</strong>: ' + names + '</div>' +
        '</div>'
      );
      setTimeout(() => { const el = document.getElementById(id); if (el) el.remove(); }, 8000);
    }

    // ===== UI Update =====
    function updateUI() {
      if (!sessionState) return;
      const { session, players, courts } = sessionState;

      document.getElementById('sessionName').textContent = session.name;

      // Update court count input
      const courtCountEl = document.getElementById('courtCountInput');
      if (courtCountEl && courts) courtCountEl.value = courts.length;

      // === Courts tab ===
      const courtsContainer = document.getElementById('courtsContainer');
      if (!courts || courts.length === 0) {
        courtsContainer.innerHTML = '<div class="empty-state"><i class="bi bi-grid-3x3-gap"></i><p>No courts available</p></div>';
      } else {
        const now = Date.now();
        courtsContainer.innerHTML = courts.map(courtData => {
          if (courtData.match) {
            const teamA = (courtData.match.players || []).filter(p => p.team === 'A');
            const teamB = (courtData.match.players || []).filter(p => p.team === 'B');
            const playerIdsA = teamA.map(r => r.player_id);
            const playerIdsB = teamB.map(r => r.player_id);
            const isStarted = !!courtData.match.match_started_at;

            const teamsHtml =
              '<div style="display:flex; gap:8px;">' +
                '<div style="flex:1;">' +
                  '<div style="text-align:center; font-size:var(--text-xs); font-weight:700; color:var(--green-700); margin-bottom:4px;">Team A</div>' +
                  playerIdsA.map(pid => {
                    const pl = players.find(p => p.id === pid);
                    return pl ? '<div class="match-player-row">' + esc(pl.name) + '</div>' : '';
                  }).join('') +
                '</div>' +
                '<div style="display:flex; align-items:center; font-weight:800; color:var(--text-muted);">vs</div>' +
                '<div style="flex:1;">' +
                  '<div style="text-align:center; font-size:var(--text-xs); font-weight:700; color:var(--coral-500); margin-bottom:4px;">Team B</div>' +
                  playerIdsB.map(pid => {
                    const pl = players.find(p => p.id === pid);
                    return pl ? '<div class="match-player-row">' + esc(pl.name) + '</div>' : '';
                  }).join('') +
                '</div>' +
              '</div>';

            if (isStarted) {
              return '<div class="court-card">' +
                '<div class="court-card__header">' +
                  '<span>' + esc(courtData.court.name) + '</span>' +
                  '<span class="badge-live">🏸 In Play</span>' +
                '</div>' +
                '<div class="court-card__body">' +
                  '<div class="match-timer" data-match-started="' + courtData.match.match_started_at + '">' +
                    formatTimer(now - courtData.match.match_started_at) +
                  '</div>' +
                  teamsHtml +
                  '<button class="hold-btn hold-btn--end" data-court-id="' + courtData.court.id + '" data-action="end">' +
                    '<span class="hold-btn__fill"></span>' +
                    '<span class="hold-btn__label">Press & Hold to END GAME</span>' +
                  '</button>' +
                '</div>' +
              '</div>';
            } else {
              return '<div class="court-card">' +
                '<div class="court-card__header">' +
                  '<span>' + esc(courtData.court.name) + '</span>' +
                  '<span class="badge-status badge-waiting">Ready</span>' +
                '</div>' +
                '<div class="court-card__body">' +
                  teamsHtml +
                  '<button class="hold-btn hold-btn--start" data-court-id="' + courtData.court.id + '" data-action="start">' +
                    '<span class="hold-btn__fill"></span>' +
                    '<span class="hold-btn__label">START GAME</span>' +
                  '</button>' +
                '</div>' +
              '</div>';
            }
          } else {
            return '<div class="court-card court-card--empty">' +
              '<div class="court-card__header">' + esc(courtData.court.name) + '</div>' +
              '<div class="court-card__body"><div style="text-align:center; color:var(--text-muted); padding:12px;">Waiting for players</div></div>' +
            '</div>';
          }
        }).join('');
      }

      // === Players tab ===
      renderPlayersTab(players);

      // === Queue tab ===
      renderQueueTab(players, courts);
    }

    function renderPlayersTab(players) {
      const allPlayers = players; // Show all RSVP'd players
      const container = document.getElementById('playersContainer');
      const summaryEl = document.getElementById('playersSummary');

      if (allPlayers.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-people"></i><p>No players yet. Share the QR code to let players join!</p></div>';
        summaryEl.innerHTML = '';
        return;
      }

      const playing = allPlayers.filter(p => p.status === 'playing').length;
      const waiting = allPlayers.filter(p => p.status === 'waiting' || p.status === 'rested').length;
      const onBreak = allPlayers.filter(p => p.status === 'break').length;
      const arrived = allPlayers.filter(p => p.arrived_at).length;
      summaryEl.innerHTML =
        '<div class="players-summary__stat"><i class="bi bi-people-fill" style="color:var(--color-primary);"></i> <strong>' + allPlayers.length + '</strong> total</div>' +
        '<div class="players-summary__stat"><span class="arrival-dot arrival-dot--arrived"></span> <strong>' + arrived + '</strong> arrived</div>' +
        '<div class="players-summary__stat"><i class="bi bi-controller" style="color:var(--coral-500);"></i> <strong>' + playing + '</strong> playing</div>' +
        '<div class="players-summary__stat"><i class="bi bi-hourglass-split" style="color:var(--green-700);"></i> <strong>' + waiting + '</strong> waiting</div>' +
        (onBreak > 0 ? '<div class="players-summary__stat"><i class="bi bi-cup-hot" style="color:#856404;"></i> <strong>' + onBreak + '</strong> on break</div>' : '');

      let html = '<div class="player-grid">';
      for (const p of allPlayers) {
        const statusBadge = '<span class="badge-status badge-' + esc(p.status) + '">' + esc(p.status.replace('_', ' ')) + '</span>';
        const arrivalDot = '<span class="arrival-dot ' + (p.arrived_at ? 'arrival-dot--arrived' : 'arrival-dot--pending') + '" title="' + (p.arrived_at ? 'Arrived ' + formatTime(p.arrived_at) : 'Not arrived') + '"></span>';

        let actions = '';
        if (p.status === 'waiting' || p.status === 'rested') {
          actions = '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="setPlayerStatus(' + p.id + ',\'break\')" title="Take a break"><i class="bi bi-cup-hot"></i></button>';
          if (userRole === 'host') {
            actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'skipped\')" title="Skip"><i class="bi bi-skip-forward"></i></button>';
          }
        } else if (p.status === 'break') {
          actions = '<button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="setPlayerStatus(' + p.id + ',\'waiting\')" title="Back in queue"><i class="bi bi-arrow-return-left"></i></button>';
        } else if (p.status === 'skipped') {
          actions = '<button class="btn-bbq btn-bbq-outline btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'waiting\')" title="Unskip"><i class="bi bi-arrow-return-left"></i></button>';
        }

        if (userRole === 'host' && p.status !== 'playing') {
          actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'left_early\')" title="Left early" style="color:var(--color-danger);"><i class="bi bi-box-arrow-right"></i></button>';
          actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="removePlayer(' + p.id + ')" title="Remove" style="color:var(--color-danger);"><i class="bi bi-x-lg"></i></button>';
        }

        html += '<div class="player-card">' +
          '<div class="player-card__info">' +
            '<div class="player-card__name">' + arrivalDot + ' ' + esc(p.name) + '</div>' +
            '<div class="player-card__meta">' +
              '<span class="badge-skill badge-' + esc(p.skill_level.toLowerCase()) + '">' + esc(p.skill_level) + '</span>' +
              statusBadge +
              '<span>' + formatTime(p.arrived_at || p.created_at) + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="player-card__stats">' +
            '<div class="player-card__wl"><span class="record-w">' + (p.wins || 0) + '</span>-<span class="record-l">' + (p.losses || 0) + '</span></div>' +
            '<div class="player-card__games">' + (p.games_played || 0) + ' games</div>' +
          '</div>' +
          (actions ? '<div class="player-card__actions">' + actions + '</div>' : '') +
        '</div>';
      }
      html += '</div>';
      container.innerHTML = html;
    }

    function renderQueueTab(players, courts) {
      const queuePlayers = players
        .filter(p => p.status === 'waiting' || p.status === 'rested')
        .sort((a, b) => {
          const gA = a.games_played || 0, gB = b.games_played || 0;
          if (gA !== gB) return gA - gB;
          const aArr = a.arrived_at || a.created_at;
          const bArr = b.arrived_at || b.created_at;
          return aArr - bArr;
        });

      const queueContainer = document.getElementById('queueContainer');
      const playersPerCourt = (sessionState && sessionState.config) ? sessionState.config.playersPerCourt : 4;

      if (queuePlayers.length === 0) {
        queueContainer.innerHTML = '<div class="empty-state"><p>No players waiting. Share the QR code or import a roster.</p></div>';
        return;
      }

      // Separate courts into available (empty) and busy (in-play)
      const allCourts = courts || [];
      const availableCourts = allCourts.filter(c => !c.match);
      const busyCourts = allCourts.filter(c => c.match);

      // Create batches of playersPerCourt
      const batches = [];
      for (let i = 0; i < queuePlayers.length; i += playersPerCourt) {
        batches.push(queuePlayers.slice(i, i + playersPerCourt));
      }

      let html = '';
      let batchIndex = 0;

      // Assign batches to available courts first ("Get Ready")
      for (const courtData of availableCourts) {
        if (batchIndex >= batches.length) break;
        html += renderBatchCard(batches[batchIndex], courtData.court.name, batchIndex + 1, playersPerCourt, 'ready');
        batchIndex++;
      }

      // Then assign remaining batches to busy courts ("Up Next — when court finishes")
      for (const courtData of busyCourts) {
        if (batchIndex >= batches.length) break;
        html += renderBatchCard(batches[batchIndex], courtData.court.name, batchIndex + 1, playersPerCourt, 'next');
        batchIndex++;
      }

      // Any leftover batches without a court
      while (batchIndex < batches.length) {
        html += renderBatchCard(batches[batchIndex], null, batchIndex + 1, playersPerCourt, 'queued');
        batchIndex++;
      }

      queueContainer.innerHTML = html || '<div class="empty-state"><p>Queue is empty</p></div>';
    }

    function renderBatchCard(batch, courtName, batchNum, playersPerCourt, status) {
      const isFull = batch.length === playersPerCourt;
      const teamsPerSide = playersPerCourt / 2;
      const teamA = batch.slice(0, teamsPerSide);
      const teamB = batch.slice(teamsPerSide);

      // Calculate how long the earliest player in this batch has been waiting
      const earliestArrival = Math.min(...batch.map(p => p.arrived_at || p.created_at));
      const waitMs = Date.now() - earliestArrival;
      const waitMin = Math.floor(waitMs / 60000);
      const waitStr = waitMin < 1 ? 'Just now' : waitMin + ' min waiting';

      // Header color and label vary by status
      let headerBg, statusLabel, statusIcon;
      if (status === 'ready') {
        headerBg = 'var(--color-primary)';
        statusLabel = 'Get Ready';
        statusIcon = '<i class="bi bi-lightning-charge-fill"></i> ';
      } else if (status === 'next') {
        headerBg = 'var(--green-900)';
        statusLabel = 'Up Next';
        statusIcon = '<i class="bi bi-hourglass-split"></i> ';
      } else {
        headerBg = 'var(--neutral-600)';
        statusLabel = 'In Queue';
        statusIcon = '<i class="bi bi-clock"></i> ';
      }

      let html = '<div class="batch-card" style="margin:0 0 12px;">';

      // Court header
      html += '<div style="background:' + headerBg + '; color:#fff; padding:10px 14px; font-family:var(--font-heading); font-weight:700; font-size:var(--text-md); display:flex; justify-content:space-between; align-items:center;">' +
        '<span>' + (courtName ? '<i class="bi bi-geo-alt-fill"></i> ' + esc(courtName) : '<i class="bi bi-question-circle"></i> Court TBD') + '</span>' +
        '<span style="font-size:var(--text-xs); font-weight:600; background:rgba(255,255,255,0.2); padding:2px 10px; border-radius:var(--radius-pill);">' + statusIcon + statusLabel + '</span>' +
      '</div>';

      // Batch sub-header with wait timer
      html += '<div style="padding:6px 14px; font-size:var(--text-xs); color:var(--text-muted); border-bottom:1px solid var(--border-subtle); font-weight:600; display:flex; justify-content:space-between; align-items:center;">' +
        '<span>Batch ' + batchNum + (isFull ? '' : ' — waiting for ' + (playersPerCourt - batch.length) + ' more') + '</span>' +
        '<span style="font-variant-numeric:tabular-nums;"><i class="bi bi-stopwatch"></i> ' + waitStr + '</span>' +
      '</div>';

      // Players body
      html += '<div class="batch-card__body">';
      if (isFull) {
        html += '<div class="batch-card__team">' +
            '<div class="batch-card__team-label" style="color:var(--green-700);">Team A</div>' +
            teamA.map(p => '<div class="match-player-row">' + esc(p.name) + '</div>').join('') +
          '</div>' +
          '<div style="display:flex; align-items:center; font-weight:800; color:var(--text-muted); padding:0 4px;">vs</div>' +
          '<div class="batch-card__team">' +
            '<div class="batch-card__team-label" style="color:var(--coral-500);">Team B</div>' +
            teamB.map(p => '<div class="match-player-row">' + esc(p.name) + '</div>').join('') +
          '</div>';
      } else {
        html += '<div style="width:100%;">' +
          batch.map(p => '<div class="match-player-row">' + esc(p.name) + '</div>').join('') +
        '</div>';
      }
      html += '</div></div>';
      return html;
    }

    // ===== Init =====
    socket.emit('get-session-state', parseInt(sessionId));

    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('SW registered:', reg.scope))
        .catch(err => console.warn('SW registration failed:', err));
    }
  </script>
</body>
</html>
