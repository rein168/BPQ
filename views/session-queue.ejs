<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BBQ - Session</title>
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1A8F55" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BBQ" />
  <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <style>
    /* Page-specific overrides */
    .team-divider {
      text-align: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-sm);
      color: var(--text-muted);
      padding: 4px 0;
    }
    .score-match-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 12px;
      background: var(--bg-card);
    }
    .score-match-card.needs-score {
      border-left: 4px solid var(--color-accent);
    }
    .score-team-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 6px 0;
    }
    .score-team-label {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-sm);
      width: 50px;
      flex-shrink: 0;
    }
    .score-team-names {
      flex: 1;
      font-size: var(--text-sm);
    }
    .score-result {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: var(--text-xl);
      font-variant-numeric: tabular-nums;
      text-align: center;
    }
    .score-result .win { color: var(--green-700); }
    .score-result .lose { color: var(--coral-500); }
    .import-section { margin-bottom: 16px; }
  </style>
</head>
<body>
  <!-- Top Nav -->
  <nav class="bbq-topnav">
    <a href="/" class="bbq-topnav__logo">
      <svg viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="34" height="34" rx="7" fill="var(--color-primary)"/>
        <line x1="9" y1="26" x2="26" y2="7" stroke="#D4A843" stroke-width="2" stroke-linecap="round"/>
        <ellipse cx="15.5" cy="19" rx="4" ry="5" fill="#fff" opacity="0.95" transform="rotate(-40, 15.5, 19)"/>
        <path d="M13,17.5 Q12.5,13 16,9 Q17,12.5 16.5,17 Z" fill="#fff" opacity="0.9"/>
        <path d="M15,16 Q16,12 19,9 Q19,13 17.5,16.5 Z" fill="#fff" opacity="0.8"/>
      </svg>
      <span>BBQ</span>
    </a>
    <div class="bbq-topnav__title" id="sessionName">Loading...</div>
    <div class="bbq-topnav__actions">
      <button class="btn-bbq btn-bbq-primary btn-bbq-sm host-only" onclick="allocateCourts()" id="allocateBtn">
        <i class="bi bi-lightning-fill"></i> Allocate
      </button>
      <button class="btn-bbq btn-bbq-danger btn-bbq-sm host-only" onclick="endSession()">
        <i class="bi bi-stop-circle"></i>
      </button>
      <button class="btn-bbq btn-bbq-outline btn-bbq-sm viewer-only" onclick="showPinModal()" id="unlockBtn" style="display:none;">
        <i class="bi bi-unlock"></i>
      </button>
    </div>
  </nav>

  <!-- PIN Auth Modal -->
  <div id="pinOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:300; display:none; align-items:center; justify-content:center;">
    <div class="bbq-card" style="max-width:320px; width:90%; margin:auto;">
      <div class="bbq-card__header"><i class="bi bi-lock-fill"></i> Host PIN Required</div>
      <div class="bbq-card__body">
        <p style="font-size:var(--text-sm); color:var(--text-secondary); margin-bottom:12px;">Enter the host PIN to manage this session, or view as a player.</p>
        <input type="text" id="pinInput" class="score-input" style="width:100%; font-size:var(--text-xl);"
          placeholder="Enter PIN" pattern="\d{4,6}" maxlength="6" inputmode="numeric" autocomplete="off" />
        <div id="pinError" style="display:none; color:var(--color-danger); font-size:var(--text-sm); margin-top:8px;"></div>
        <div style="display:flex; gap:8px; margin-top:16px;">
          <button class="btn-bbq btn-bbq-ghost" style="flex:1;" onclick="skipPin()">View as Player</button>
          <button class="btn-bbq btn-bbq-primary" style="flex:1;" onclick="submitPin()">Authenticate</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content area — tab panes -->
  <main style="padding: 16px; max-width: 960px; margin: 0 auto;">

    <!-- COURTS TAB -->
    <div id="tab-courts" class="tab-pane active">
      <div id="courtsContainer">
        <div class="empty-state">
          <i class="bi bi-grid-3x3-gap"></i>
          <p>No courts allocated yet</p>
        </div>
      </div>
    </div>

    <!-- QUEUE TAB -->
    <div id="tab-queue" class="tab-pane">
      <!-- Import (host only) -->
      <div class="bbq-card import-section host-only">
        <div class="bbq-card__header"><i class="bi bi-file-text"></i> Import Players</div>
        <div class="bbq-card__body">
          <form id="importForm">
            <textarea id="playerList" rows="4" placeholder="Paste player names, one per line"
              style="width:100%; padding:10px; border:1px solid var(--border); border-radius:var(--radius-sm); font-family:var(--font-body); font-size:var(--text-sm); resize:vertical; background:var(--bg-page); color:var(--text-primary);"></textarea>
            <div style="display:flex; gap:8px; margin-top:8px;">
              <select id="skillLevel" required
                style="flex:1; padding:8px; border:1px solid var(--border); border-radius:var(--radius-sm); font-family:var(--font-body); font-size:var(--text-sm); background:var(--bg-card); color:var(--text-primary);">
                <option value="">Skill Level</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
              </select>
              <button type="submit" class="btn-bbq btn-bbq-primary">
                <i class="bi bi-upload"></i> Import
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Queue list -->
      <div class="bbq-card">
        <div class="bbq-card__header"><i class="bi bi-hourglass-split"></i> Waiting Queue</div>
        <div id="queueContainer">
          <div class="empty-state"><p>Queue is empty</p></div>
        </div>
      </div>
    </div>

    <!-- SCORE TAB (host only) -->
    <div id="tab-score" class="tab-pane">
      <div class="bbq-card">
        <div class="bbq-card__header"><i class="bi bi-trophy"></i> Match Scores</div>
        <div class="bbq-card__body" id="scoreContainer">
          <div class="empty-state"><p>No completed matches yet</p></div>
        </div>
      </div>
    </div>

  </main>

  <!-- Notification container -->
  <div id="notificationContainer"></div>

  <!-- Bottom Nav -->
  <nav class="bbq-bottomnav">
    <button class="bbq-bottomnav__tab active" onclick="switchTab('courts', this)">
      <i class="bi bi-grid-3x3-gap-fill"></i>
      Courts
    </button>
    <button class="bbq-bottomnav__tab" onclick="switchTab('queue', this)">
      <i class="bi bi-people-fill"></i>
      Queue
    </button>
    <button class="bbq-bottomnav__tab host-only-tab" onclick="switchTab('score', this)">
      <i class="bi bi-trophy-fill"></i>
      Score
    </button>
  </nav>

  <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
  <script>
    const sessionId = window.location.pathname.split('/').pop();
    const socket = io();
    let sessionState = null;
    let userRole = 'viewer';
    let timerInterval = null;
    let matchHistory = []; // cached for score tab

    // XSS-safe text helper
    function esc(str) {
      if (str == null) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Format milliseconds as MM:SS
    function formatTimer(ms) {
      const totalSec = Math.floor(ms / 1000);
      const m = Math.floor(totalSec / 60);
      const s = totalSec % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    // Format arrival time
    function formatTime(ts) {
      if (!ts) return '—';
      return new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    }

    // Timer tick
    function startTimerTick() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        document.querySelectorAll('[data-match-started]').forEach(el => {
          const started = parseInt(el.getAttribute('data-match-started'), 10);
          if (started) el.textContent = formatTimer(Date.now() - started);
        });
      }, 1000);
    }
    startTimerTick();

    // ===== Tab switching =====
    function switchTab(tabName, btnEl) {
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.bbq-bottomnav__tab').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + tabName).classList.add('active');
      if (btnEl) btnEl.classList.add('active');
      // Load score data when switching to score tab
      if (tabName === 'score') loadMatchHistory();
    }

    // ===== Role management =====
    async function checkRole() {
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/role');
        const data = await response.json();
        setRole(data.role);
        if (data.hasPin && data.role !== 'host') {
          document.getElementById('pinOverlay').style.display = 'flex';
        }
      } catch (err) {
        console.error('Error checking role:', err);
        setRole('viewer');
      }
    }

    function setRole(role) {
      userRole = role;
      document.body.classList.remove('role-host', 'role-viewer');
      document.body.classList.add('role-' + role);
    }

    function showPinModal() {
      document.getElementById('pinOverlay').style.display = 'flex';
    }

    async function submitPin() {
      const pin = document.getElementById('pinInput').value.trim();
      const errorEl = document.getElementById('pinError');
      errorEl.style.display = 'none';
      if (!pin) { errorEl.textContent = 'Please enter a PIN'; errorEl.style.display = 'block'; return; }
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin })
        });
        const data = await response.json();
        if (data.success) {
          setRole('host');
          document.getElementById('pinOverlay').style.display = 'none';
          document.getElementById('pinInput').value = '';
        } else {
          errorEl.textContent = data.error || 'Incorrect PIN';
          errorEl.style.display = 'block';
        }
      } catch {
        errorEl.textContent = 'Error authenticating';
        errorEl.style.display = 'block';
      }
    }

    function skipPin() {
      setRole('viewer');
      document.getElementById('pinOverlay').style.display = 'none';
    }

    document.getElementById('pinInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') submitPin();
    });

    checkRole();

    // ===== Socket =====
    socket.emit('join-session', parseInt(sessionId));

    socket.on('session:' + sessionId, (data) => {
      sessionState = data;
      updateUI();
    });

    socket.on('session:' + sessionId + ':court-assigned', (data) => {
      showCourtNotification(data);
    });

    // ===== Import =====
    document.getElementById('importForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const playerNames = document.getElementById('playerList').value.trim().split('\n').filter(n => n.trim());
      const skillLevel = document.getElementById('skillLevel').value;
      if (!playerNames.length || !skillLevel) { alert('Please enter player names and select skill level'); return; }

      const players = playerNames.map(name => ({ name: name.trim(), skill_level: skillLevel }));
      try {
        const response = await fetch('/api/players/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), players })
        });
        const data = await response.json();
        if (data.success) {
          document.getElementById('playerList').value = '';
          socket.emit('get-session-state', parseInt(sessionId));
        }
      } catch (err) {
        alert('Error importing players: ' + err.message);
      }
    });

    // ===== Actions =====
    async function allocateCourts() {
      try {
        const response = await fetch('/api/queue/allocate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
        const data = await response.json();
        if (!data.allocated || data.allocated.length === 0) {
          alert(data.message);
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function finishMatch(courtId) {
      if (!confirm('Mark this game as finished?')) return;
      try {
        const response = await fetch('/api/queue/' + courtId + '/finish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
        const data = await response.json();
        if (data.success && data.historyId) {
          // Prompt for score entry
          promptScore(data.historyId, courtId);
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    function promptScore(historyId, courtId) {
      // Switch to score tab so host can enter score for the just-finished match
      const scoreBtn = document.querySelector('.bbq-bottomnav__tab:nth-child(3)');
      switchTab('score', scoreBtn);
      loadMatchHistory();
    }

    async function endSession() {
      if (!confirm('End this session? This action cannot be undone.')) return;
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/end', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) window.location.href = '/';
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function setPlayerStatus(playerId, status) {
      try {
        await fetch('/api/players/' + playerId + '/status', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), status })
        });
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function removePlayer(playerId) {
      if (!confirm('Remove this player?')) return;
      try {
        await fetch('/api/players/' + playerId, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId) })
        });
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ===== Score entry =====
    async function loadMatchHistory() {
      try {
        const response = await fetch('/api/sessions/' + sessionId + '/history');
        const data = await response.json();
        matchHistory = data.history || [];
        renderScoreTab();
      } catch (err) {
        console.error('Error loading history:', err);
      }
    }

    function renderScoreTab() {
      const container = document.getElementById('scoreContainer');
      if (matchHistory.length === 0) {
        container.innerHTML = '<div class="empty-state"><p>No completed matches yet</p></div>';
        return;
      }

      container.innerHTML = matchHistory.map(match => {
        const teamA = match.players.filter(p => p.team === 'A');
        const teamB = match.players.filter(p => p.team === 'B');
        const hasScore = match.score_a != null && match.score_b != null;
        const duration = (match.duration_ms / 60000).toFixed(1);

        if (hasScore) {
          const aWin = match.score_a > match.score_b;
          return '<div class="score-match-card">' +
            '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">' +
              '<span style="font-size:var(--text-xs); color:var(--text-muted);">' + duration + ' min</span>' +
              '<span style="font-size:var(--text-xs); color:var(--text-muted);">' + new Date(match.completed_at).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}) + '</span>' +
            '</div>' +
            '<div class="score-team-row">' +
              '<span class="score-team-label" style="color:var(--green-700);">A</span>' +
              '<span class="score-team-names">' + teamA.map(p => esc(p.name)).join(' & ') + '</span>' +
              '<span class="score-result ' + (aWin ? 'win' : 'lose') + '">' + match.score_a + '</span>' +
            '</div>' +
            '<div class="score-team-row">' +
              '<span class="score-team-label" style="color:var(--coral-500);">B</span>' +
              '<span class="score-team-names">' + teamB.map(p => esc(p.name)).join(' & ') + '</span>' +
              '<span class="score-result ' + (!aWin ? 'win' : 'lose') + '">' + match.score_b + '</span>' +
            '</div>' +
          '</div>';
        } else {
          // Needs score entry
          return '<div class="score-match-card needs-score">' +
            '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">' +
              '<span style="font-size:var(--text-xs); color:var(--color-accent); font-weight:600;">Score needed</span>' +
              '<span style="font-size:var(--text-xs); color:var(--text-muted);">' + duration + ' min</span>' +
            '</div>' +
            '<div class="score-team-row">' +
              '<span class="score-team-label" style="color:var(--green-700);">A</span>' +
              '<span class="score-team-names">' + teamA.map(p => esc(p.name)).join(' & ') + '</span>' +
              '<input type="number" class="score-input" id="scoreA-' + match.id + '" min="0" max="99" placeholder="0" />' +
            '</div>' +
            '<div class="score-team-row">' +
              '<span class="score-team-label" style="color:var(--coral-500);">B</span>' +
              '<span class="score-team-names">' + teamB.map(p => esc(p.name)).join(' & ') + '</span>' +
              '<input type="number" class="score-input" id="scoreB-' + match.id + '" min="0" max="99" placeholder="0" />' +
            '</div>' +
            '<button class="btn-bbq btn-bbq-accent btn-bbq-sm" style="width:100%; margin-top:8px;" onclick="submitScore(' + match.id + ')">' +
              '<i class="bi bi-check-lg"></i> Save Score' +
            '</button>' +
          '</div>';
        }
      }).join('');
    }

    async function submitScore(matchId) {
      const scoreAEl = document.getElementById('scoreA-' + matchId);
      const scoreBEl = document.getElementById('scoreB-' + matchId);
      if (!scoreAEl || !scoreBEl) return;
      const scoreA = parseInt(scoreAEl.value, 10);
      const scoreB = parseInt(scoreBEl.value, 10);
      if (isNaN(scoreA) || isNaN(scoreB)) { alert('Please enter both scores'); return; }
      try {
        const response = await fetch('/api/queue/score/' + matchId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: parseInt(sessionId), scoreA, scoreB })
        });
        const data = await response.json();
        if (data.success) {
          loadMatchHistory();
          // Refresh player stats (W/L updates)
          socket.emit('get-session-state', parseInt(sessionId));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ===== Notification toast =====
    function showCourtNotification(data) {
      const container = document.getElementById('notificationContainer');
      const id = 'notif-' + Date.now();
      const names = data.playerNames.map(n => esc(n)).join(', ');
      container.insertAdjacentHTML('beforeend',
        '<div id="' + id + '" class="bbq-toast">' +
          '<button class="bbq-toast__close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>' +
          '<div class="bbq-toast__title"><i class="bi bi-arrow-right-circle-fill"></i> Next Up!</div>' +
          '<div class="bbq-toast__body"><strong>' + esc(data.courtName) + '</strong>: ' + names + '</div>' +
        '</div>'
      );
      setTimeout(() => { const el = document.getElementById(id); if (el) el.remove(); }, 8000);
    }

    // ===== UI Update =====
    function updateUI() {
      if (!sessionState) return;
      const { session, players, courts } = sessionState;

      document.getElementById('sessionName').textContent = session.name;

      // === Courts tab ===
      const courtsContainer = document.getElementById('courtsContainer');
      if (!courts || courts.length === 0) {
        courtsContainer.innerHTML = '<div class="empty-state"><i class="bi bi-grid-3x3-gap"></i><p>No courts available</p></div>';
      } else {
        const now = Date.now();
        courtsContainer.innerHTML = courts.map(courtData => {
          if (courtData.match) {
            const teamA = (courtData.match.players || []).filter(p => p.team === 'A');
            const teamB = (courtData.match.players || []).filter(p => p.team === 'B');
            const playerIdsA = teamA.map(r => r.player_id);
            const playerIdsB = teamB.map(r => r.player_id);

            return '<div class="court-card">' +
              '<div class="court-card__header">' +
                '<span>' + esc(courtData.court.name) + '</span>' +
                '<span class="badge-live">🏸 In Play</span>' +
              '</div>' +
              '<div class="court-card__body">' +
                '<div class="match-timer" data-match-started="' + courtData.match.match_started_at + '">' +
                  formatTimer(now - courtData.match.match_started_at) +
                '</div>' +
                '<div style="display:flex; gap:8px;">' +
                  '<div style="flex:1;">' +
                    '<div style="text-align:center; font-size:var(--text-xs); font-weight:700; color:var(--green-700); margin-bottom:4px;">Team A</div>' +
                    playerIdsA.map(pid => {
                      const pl = players.find(p => p.id === pid);
                      return pl ? '<div class="match-player-row">' + esc(pl.name) + '</div>' : '';
                    }).join('') +
                  '</div>' +
                  '<div style="display:flex; align-items:center; font-weight:800; color:var(--text-muted);">vs</div>' +
                  '<div style="flex:1;">' +
                    '<div style="text-align:center; font-size:var(--text-xs); font-weight:700; color:var(--coral-500); margin-bottom:4px;">Team B</div>' +
                    playerIdsB.map(pid => {
                      const pl = players.find(p => p.id === pid);
                      return pl ? '<div class="match-player-row">' + esc(pl.name) + '</div>' : '';
                    }).join('') +
                  '</div>' +
                '</div>' +
                '<button class="btn-bbq btn-bbq-accent host-only" style="width:100%; margin-top:12px;" onclick="finishMatch(' + courtData.court.id + ')">' +
                  '<i class="bi bi-check-circle"></i> Game Finished' +
                '</button>' +
              '</div>' +
            '</div>';
          } else {
            return '<div class="court-card court-card--empty">' +
              '<div class="court-card__header">' + esc(courtData.court.name) + '</div>' +
              '<div class="court-card__body">Waiting for allocation</div>' +
            '</div>';
          }
        }).join('');
      }

      // === Queue tab ===
      // Show all non-absent players in queue view, sorted: waiting/rested first, then break/skipped
      const allPlayers = players.filter(p => p.status !== 'absent' || userRole === 'host');
      const queueContainer = document.getElementById('queueContainer');

      if (allPlayers.length === 0) {
        queueContainer.innerHTML = '<div class="empty-state"><p>No players yet. Import a roster to get started.</p></div>';
      } else {
        // Table header
        let html = '<div style="overflow-x:auto;">' +
          '<table style="width:100%; border-collapse:collapse; font-size:var(--text-sm);">' +
          '<thead><tr style="border-bottom:2px solid var(--border);">' +
            '<th style="text-align:left; padding:8px 12px; font-family:var(--font-heading); font-weight:600; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Player</th>' +
            '<th style="text-align:center; padding:8px 6px; font-family:var(--font-heading); font-weight:600; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">W-L</th>' +
            '<th style="text-align:center; padding:8px 6px; font-family:var(--font-heading); font-weight:600; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Games</th>' +
            '<th style="text-align:center; padding:8px 6px; font-family:var(--font-heading); font-weight:600; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Arrived</th>' +
            '<th style="text-align:center; padding:8px 6px; font-family:var(--font-heading); font-weight:600; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Status</th>' +
            '<th style="padding:8px 6px;" class="host-only"></th>' +
          '</tr></thead><tbody>';

        for (const p of allPlayers) {
          const wl = (p.wins || 0) + '-' + (p.losses || 0);
          const statusBadge = '<span class="badge-status badge-' + esc(p.status) + '">' + esc(p.status.replace('_', ' ')) + '</span>';

          // Action buttons based on status
          let actions = '';
          if (p.status === 'waiting' || p.status === 'rested') {
            actions = '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm" onclick="setPlayerStatus(' + p.id + ',\'break\')" title="Take a break"><i class="bi bi-cup-hot"></i></button>';
            if (userRole === 'host') {
              actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'skipped\')" title="Skip"><i class="bi bi-skip-forward"></i></button>';
            }
          } else if (p.status === 'break') {
            actions = '<button class="btn-bbq btn-bbq-outline btn-bbq-sm" onclick="setPlayerStatus(' + p.id + ',\'waiting\')" title="Back in queue"><i class="bi bi-arrow-return-left"></i></button>';
          } else if (p.status === 'skipped') {
            actions = '<button class="btn-bbq btn-bbq-outline btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'waiting\')" title="Unskip"><i class="bi bi-arrow-return-left"></i></button>';
          }

          if (userRole === 'host' && p.status !== 'playing') {
            actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="setPlayerStatus(' + p.id + ',\'left_early\')" title="Left early" style="color:var(--color-danger);"><i class="bi bi-box-arrow-right"></i></button>';
            actions += '<button class="btn-bbq btn-bbq-ghost btn-bbq-sm host-only" onclick="removePlayer(' + p.id + ')" title="Remove" style="color:var(--color-danger);"><i class="bi bi-x-lg"></i></button>';
          }

          html += '<tr style="border-bottom:1px solid var(--border-subtle);">' +
            '<td style="padding:8px 12px;">' +
              '<div style="font-weight:500;">' + esc(p.name) + '</div>' +
              '<span class="badge-skill badge-' + esc(p.skill_level.toLowerCase()) + '">' + esc(p.skill_level) + '</span>' +
            '</td>' +
            '<td style="text-align:center; padding:8px 6px; font-variant-numeric:tabular-nums; font-weight:600;">' +
              '<span class="record-w">' + (p.wins || 0) + '</span>-<span class="record-l">' + (p.losses || 0) + '</span>' +
            '</td>' +
            '<td style="text-align:center; padding:8px 6px; font-variant-numeric:tabular-nums; font-weight:600;">' + (p.games_played || 0) + '</td>' +
            '<td style="text-align:center; padding:8px 6px; font-size:var(--text-xs); color:var(--text-muted);">' + formatTime(p.arrived_at || p.created_at) + '</td>' +
            '<td style="text-align:center; padding:8px 6px;">' + statusBadge + '</td>' +
            '<td style="padding:8px 6px; white-space:nowrap;" class="host-only">' + actions + '</td>' +
          '</tr>';
        }

        html += '</tbody></table></div>';
        queueContainer.innerHTML = html;
      }
    }

    // ===== Init =====
    socket.emit('get-session-state', parseInt(sessionId));

    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('SW registered:', reg.scope))
        .catch(err => console.warn('SW registration failed:', err));
    }
  </script>
</body>
</html>
