# Server Configuration
PORT=3000
NODE_ENV=development

# Cookie Secret (REQUIRED in production — app will refuse to start without it)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=your_secure_cookie_secret_here_change_in_production

# CORS Origins (leave unset for same-origin — recommended for production)
# CORS_ORIGINS=http://localhost:3000

# Court capacity: 4 for doubles (default), 2 for singles
# PLAYERS_PER_COURT=4
